---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import SiteEffects from '../components/SiteEffects.tsx';
import HeroProduct from '../components/HeroProduct.tsx';
import AppDemo from '../components/AppDemo.tsx';
import PricingToggle from '../components/PricingToggle.tsx';
import HeroTitle from '../components/HeroTitle.tsx';
import FaqAccordion from '../components/FaqAccordion.tsx';
import {
  Apple,
  Play,
  Moon,
  HeartPulse,
  MapPin,
  Dumbbell,
  Bell,
  Battery,
  Check,
  Star,
  Zap,
  MousePointerClick,
  Gauge,
  Smartphone,
  ShieldCheck,
  RotateCcw,
} from 'lucide-react';

const marqueeWords = [
  'SUEÑO PROFUNDO',
  'ZONAS DE RITMO CARDIACO',
  'GPS OUTDOOR',
  '+100 ENTRENAMIENTOS',
  'COACHING PERSONAL',
  '14 DÍAS DE BATERÍA',
];

const features = [
  {
    icon: Moon,
    title: 'Seguimiento del sueño',
    body: 'Fases REM, ligero y profundo con puntuación diaria y consejos para descansar mejor.',
  },
  {
    icon: HeartPulse,
    title: 'Zonas de ritmo cardiaco',
    body: '5 zonas entrenables en tiempo real con alertas para no salirte de tu ritmo objetivo.',
  },
  {
    icon: MapPin,
    title: 'GPS Outdoor',
    body: 'Rutas, ritmo y desnivel en carrera, bici y senderismo con mapas al detalle.',
  },
  {
    icon: Dumbbell,
    title: '+100 entrenamientos',
    body: 'Circuitos guiados en pantalla con repeticiones, descansos y corrección de forma.',
  },
  {
    icon: Bell,
    title: 'Notificaciones inteligentes',
    body: 'Llamadas, mensajes y citas en la muñeca. Silencia con un gesto al dormir.',
  },
  {
    icon: Battery,
    title: 'Batería para 14 días',
    body: 'Carga rápida de 30 minutos y modo ahorro para travesías de varios días.',
  },
];

const plans = [
  {
    name: 'Free',
    price: '$0',
    period: '/mes',
    cta: 'Empezar gratis',
    highlight: false,
    perks: ['3 entrenamientos base', 'Pasos y calorías', 'Sueño básico', '1 dispositivo'],
  },
  {
    name: 'Pro',
    price: '$9.99',
    period: '/mes',
    cta: 'Probar Pro gratis',
    highlight: true,
    perks: ['+100 entrenamientos guiados', 'Zonas de ritmo en vivo', 'Sueño avanzado + score', 'Planes personalizados IA', 'Modo multideporte'],
  },
  {
    name: 'Premium',
    price: '$19.99',
    period: '/mes',
    cta: 'Elegir Premium',
    highlight: false,
    perks: ['Todo lo de Pro', 'Coaching 1-a-1 mensual', 'Métricas de recuperación', 'Comparte con 2 cuentas', 'Acceso anticipado a funciones'],
  },
];

const faqs = [
  {
    q: '¿Funciona el smartwatch con iPhone y Android?',
    a: 'Sí. FitPro Sense es compatible con iOS 15+ y Android 10+ a través de la app FitPro Tracker disponible en App Store y Google Play.',
  },
  {
    q: '¿Necesito el plan Pro para usar la app?',
    a: 'No. El plan Free cubre lo esencial: pasos, calorías, sueño básico y 3 entrenamientos. Pro y Premium desbloquean el entrenamiento completo y las métricas avanzadas.',
  },
  {
    q: '¿Los datos de salud son privados?',
    a: 'Sí. Tus métricas se cifran de extremo a extremo y nunca se venden. Tú decides qué compartir y puedes exportarlos o borrarlos cuando quieras.',
  },
  {
    q: '¿Puedo cancelar el plan cuando quiera?',
    a: 'Por supuesto. Sin permanencia: cancela en dos toques desde la app y mantienes Premium hasta el final del periodo pagado.',
  },
  {
    q: '¿La batería aguanta toda la semana?',
    a: 'Sí, hasta 14 días con uso típico. Una carga de 30 minutos da 5 días de batería gracias al modo de carga rápida.',
  },
];

const testimonials = [
  {
    name: 'Lucía Fernández',
    role: 'Runner · Madrid',
    metric: '−12 kg en 6 meses',
    initials: 'LF',
    quote:
      'Los entrenamientos guiados me corrigieron la zancada. Con las zonas de ritmo en vivo mi 10K bajó 4 minutos en un trimestre.',
  },
  {
    name: 'Carlos Vidal',
    role: 'Triatleta · Barcelona',
    metric: '42 km de media semanal',
    initials: 'CV',
    quote:
      'El modo multideporte es brutal: transiciones perfectas entre natación, bici y carrera, con los datos sin separarse nunca de mi muñeca.',
  },
  {
    name: 'Marta Ruiz',
    role: 'Yoga & movilidad · Valencia',
    metric: 'Score de sueño 92/100',
    initials: 'MR',
    quote:
      'El score de sueño me cambió la rutina: ahora mi cuerpo decide cuándo entrenar fuerte y cuándo recuperar. Entrenar mejor, no más.',
  },
];
---

<Layout>
  <!-- HERO -->
  <section id="top" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute left-1/2 top-0 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-accent/5 blur-3xl"></div>
    </div>
    <div class="container-md relative grid items-center gap-14 pb-24 pt-32 lg:grid-cols-2 lg:pt-40">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent" data-hero-cascade>
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70 motion-reduce:animate-none"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          Nuevo · Coach IA integrado
        </span>
        <HeroTitle client:load />
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-200" data-hero-cascade>
          FitPro Tracker combina un smartwatch ultraligero y una app inteligente para llevar tu
          <strong class="font-semibold text-accent">sueño</strong>, tu
          <strong class="font-semibold text-accent">ritmo cardiaco</strong> y tus
          <strong class="font-semibold text-accent">entrenamientos</strong> al siguiente nivel.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-hero-cascade>
          <a href="#plans" class="btn-accent glow">Empezar gratis</a>
          <a href="#plans" class="btn-ghost">Ver planes</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-3" data-hero-cascade>
          <a href="#" class="flex items-center gap-3 rounded-xl border border-white/10 px-4 py-2.5 transition-colors hover:border-accent/60" aria-label="Descargar en la App Store">
            <Apple class="h-6 w-6 text-white" aria-hidden="true" />
            <span class="text-left leading-tight">
              <span class="block text-[10px] uppercase tracking-wide text-slate-400">Descargar en</span>
              <span class="block text-sm font-semibold text-white">App Store</span>
            </span>
          </a>
          <a href="#" class="flex items-center gap-3 rounded-xl border border-white/10 px-4 py-2.5 transition-colors hover:border-accent/60" aria-label="Disponible en Google Play">
            <Play class="h-6 w-6 text-white" aria-hidden="true" />
            <span class="text-left leading-tight">
              <span class="block text-[10px] uppercase tracking-wide text-slate-400">Disponible en</span>
              <span class="block text-sm font-semibold text-white">Google Play</span>
            </span>
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Especificaciones" data-hero-cascade>
          {['BPM en vivo', 'GPS dual', 'Senso 3', '14 días batería', '5ATM'].map((spec) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-surface/70 px-3 py-1.5 text-xs font-semibold text-slate-200 backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              {spec}
            </li>
          ))}
        </ul>
      </div>

      <!-- Producto 2.5D: tilt + parallax + float (P1) -->
      <HeroProduct client:load />
    </div>

    <!-- MARQUEE -->
    <div class="marquee border-y border-white/5 bg-surface/40 py-3" aria-hidden="true">
      <div class="marquee-track font-display text-sm font-semibold uppercase tracking-[0.25em] text-slate-400">
        {[...marqueeWords, ...marqueeWords].map((w, i) => (
          <span key={i} class="flex items-center gap-3">
            {w}
            <Zap class="h-4 w-4 text-accent/60" />
          </span>
        ))}
      </div>
    </div>

    <!-- STRIP -->
    <div class="border-y border-white/5 bg-surface/40">
      <div class="container-md grid grid-cols-3 divide-x divide-white/5 py-6 text-center">
        <div>
          <p class="font-display text-2xl font-bold text-accent sm:text-3xl" data-count-to="2" data-count-suffix="M+">2M+</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-slate-400">Usuarios</p>
        </div>
        <div>
          <p class="font-display text-2xl font-bold text-accent sm:text-3xl" data-count-to="40" data-count-suffix="M">40M</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-slate-400">Entrenamientos</p>
        </div>
        <div>
          <p class="font-display text-2xl font-bold text-accent sm:text-3xl" data-count-to="4.9" data-count-decimals="1" data-count-suffix="★">4,9★</p>
          <p class="mt-1 text-xs uppercase tracking-widest text-slate-400">Valoración</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="relative overflow-hidden py-24">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -left-40 top-20 h-96 w-96 rounded-full bg-accent/5 blur-3xl"></div>
      <div class="absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-accent/5 blur-3xl"></div>
    </div>
    <div class="container-md relative">
    <SectionHead
      eyebrow="Funciones"
      title="Todo lo que tu cuerpo te cuenta"
      sub="Seis sistemas trabajando juntos para un retrato completo de tu día, tu sueño y tu rendimiento."
    />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        features.map((f, i) => (
          <article class="card group relative p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_20px_50px_rgba(0,0,0,.45)]" data-reveal>
            <span class="pointer-events-none absolute right-4 top-3 font-display text-3xl font-bold text-white/5" aria-hidden="true">
              0{i + 1}
            </span>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-accent/25 to-accent/5 text-accent transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6 group-hover:glow">
              <f.icon class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-white">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- DEMO -->
  <section id="demo" class="border-y border-white/5 bg-surface/30">
    <div class="container-md flex flex-col items-center gap-12 py-24 lg:flex-row">
      <div class="relative flex-1">
        <div class="absolute -inset-8 rounded-full bg-accent/5 blur-3xl motion-safe:animate-pulse-glow" aria-hidden="true"></div>
        <div class="relative" data-reveal>
          <AppDemo client:visible />
        </div>
      </div>
      <div class="flex-1">
        <SectionHead
          eyebrow="Demo interactiva"
          title="Prueba la app sin instalarla"
          sub="Alterna entre Dashboard, Sueño y Zonas para ver cómo se lee tu cuerpo en tiempo real."
        />
        <div class="mt-8 grid gap-4 sm:grid-cols-3" data-reveal-group>
          {[
            {
              icon: MousePointerClick,
              title: 'Cambia de pantalla',
              body: 'Tres vistas: Dashboard, Sueño y Zonas. Con ratón o con las flechas del teclado.',
            },
            {
              icon: Gauge,
              title: 'Datos en vivo',
              body: 'Cada vista arranca sus métricas y barras desde cero y las anima en segundos.',
            },
            {
              icon: Smartphone,
              title: 'Como en la muñeca',
              body: 'Exactamente la misma experiencia que verías en tu FitPro Sense.',
            },
          ].map((s, i) => (
            <div key={i} class="card p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40" data-reveal>
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-accent/25 to-accent/5 text-accent">
                <s.icon class="h-5 w-5" aria-hidden="true" />
              </span>
              <p class="mt-3 text-sm font-semibold text-white">{s.title}</p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-400">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

<!-- STATS BAND -->
  <section class="relative overflow-hidden py-24" aria-label="Estadísticas">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/2 top-1/2 h-80 w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-3xl"></div>
    </div>
    <div class="container-md relative grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['12.4', 'kcal quemadas', 'M'],
        ['3.1', 'horas de sueño', 'M'],
        ['18.2', 'sesiones guiadas', 'M'],
        ['97', 'racha media activa', ' días'],
      ].map(([value, label, suffix]) => (
        <div class="card p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-accent/40" data-reveal>
          <p class="font-display text-4xl font-bold text-white drop-shadow-[0_0_24px_rgba(74,222,128,.35)]" data-count-to={value} data-count-decimals={value.includes('.') ? 1 : 0} data-count-suffix={suffix}>{value}{suffix}</p>
          <p class="mt-2 text-xs uppercase tracking-widest text-slate-400">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="border-y border-white/5 bg-surface/30">
    <div class="container-md py-24">
      <SectionHead
        eyebrow="Precios"
        title="Un plan para cada objetivo"
        sub="Empieza gratis y mejora cuando tu entrenamiento lo pida. Sin permanencia ni sorpresas."
      />
      <div class="mt-8 flex flex-col items-center gap-2">
        <PricingToggle client:load />
        <p id="plan-billing-hint" class="text-xs text-slate-400">facturado mensualmente</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          plans.map((p) => (
            <div class={`relative ${p.highlight ? 'mt-4' : ''}`}>
              {p.highlight && (
                <span class="absolute -top-3 left-1/2 z-20 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-bg-dark">
                  Más popular
                </span>
              )}
              <div class={`relative h-full ${p.highlight ? 'overflow-hidden rounded-2xl p-px' : ''}`}>
                {p.highlight && (
                  <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
                    <div class="h-[80rem] w-[80rem] animate-spin [animation-duration:8s] bg-[conic-gradient(from_0deg,transparent_0deg,rgba(74,222,128,0.7)_40deg,transparent_120deg)] motion-reduce:animate-none"></div>
                  </div>
                )}
                <article class={`card relative flex h-full flex-col p-7 ${p.highlight ? 'glow border-accent/50 bg-gradient-to-b from-accent/10 to-surface' : ''}`}>
                  <h3 class="font-display text-xl font-semibold text-white">{p.name}</h3>
                <p class="mt-3 flex items-end gap-1 font-display text-4xl font-bold text-white">
                  <span class="text-base font-medium text-slate-500">$</span>
                  {p.name === 'Pro'
                    ? <span id="plan-pro-price">9,99</span>
                    : p.name === 'Premium'
                      ? <span id="plan-premium-price">19,99</span>
                      : <span>0</span>}
                  <span class="pb-1 text-base font-medium text-slate-500">{p.period}</span>
                </p>
                <ul class="mt-6 flex-1 space-y-3">
                  {p.perks.map((perk) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-200">
                      <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                      {perk}
                    </li>
                  ))}
                </ul>
                <a href="#" class={`${p.highlight ? 'btn-accent glow-strong mt-8' : 'btn-ghost mt-8'}`}>
                  {p.cta}
                </a>
              </article>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section id="faq" class="container-md py-24" aria-label="Testimonios">
    <SectionHead
      eyebrow="Testimonios"
      title="Historias que suman"
      sub="Miles de personas entrenan, duermen y mejoran con FitPro cada día."
    />
    <div class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
      {
        testimonials.map((t) => (
          <blockquote class="card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_20px_50px_rgba(0,0,0,.45)]" data-reveal>
            <div class="flex gap-1 text-accent" aria-label="5 de 5 estrellas">
              {[...Array(5)].map((_, i) => (
                <Star key={i} class="h-4 w-4 fill-current drop-shadow-[0_0_8px_rgba(74,222,128,.5)]" aria-hidden="true" />
              ))}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-200">"{t.quote}"</p>
            <footer class="mt-5 flex items-center gap-3">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-accent/40 to-surface-2 font-display text-sm font-bold text-white ring-2 ring-accent/30">
                {t.initials}
              </span>
              <div>
                <p class="text-sm font-semibold text-white">{t.name}</p>
                <p class="text-xs text-slate-400">{t.role} · <span class="font-semibold text-accent">{t.metric}</span></p>
              </div>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="container-md max-w-3xl pb-24">
    <SectionHead eyebrow="FAQ" title="Preguntas frecuentes" />
    <div data-reveal>
      <FaqAccordion client:load items={faqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="container-md pb-24" aria-label="Llamada final a la acción">
    <div class="card relative overflow-hidden p-10 text-center sm:p-14" data-reveal>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-accent/15 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -top-28 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
      <h2 class="relative font-display text-3xl font-bold text-white sm:text-4xl">
        Empieza a <span class="text-gradient-accent">entrenar mejor</span> hoy
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-lg text-slate-200">
        Únete a la lista de espera y consigue <strong class="font-semibold text-accent">3 meses de Pro gratis</strong> cuando lancemos.
      </p>
      <div class="relative mt-8 flex justify-center gap-3">
        <a href="#plans" class="btn-accent glow-strong px-7 py-3.5 text-base">Empieza gratis</a>
        <a href="#faq" class="btn-ghost px-7 py-3.5 text-base">Ver FAQ</a>
      </div>
      <p class="relative mt-6 flex items-center justify-center gap-5 text-xs text-slate-300">
        <span class="inline-flex items-center gap-1.5">
          <ShieldCheck class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
          Sin permanencia
        </span>
        <span class="h-1 w-1 rounded-full bg-slate-500" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-1.5">
          <RotateCcw class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
          Cancela cuando quieras
        </span>
      </p>
    </div>
  </section>

  <SiteEffects client:load />
</Layout>
---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
}
const { eyebrow, title, sub } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {sub && <p class="mt-4 text-base text-slate-400">{sub}</p>}
</div>